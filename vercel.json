{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "web/frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "backend": {
      "root": "web/backend",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "bindings": [
        { "type": "service", "service": "ai-service", "format": "url", "env": "AI_SERVICE_URL" }
      ]
    },
    "ai-service": {
      "root": "ai-service",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
